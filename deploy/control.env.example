# Explicit configuration only. Replace placeholders with local credentials.
CONTROL_ENV=development
CONTROL_DATABASE_URL=postgresql://fleet_dev_admin@127.0.0.1:55439/fleet_dev_control
CONTROL_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
CONTROL_ACCOUNT_KEY=
CONTROL_ARTIFACT_DIR=H:/Datascraper-updates/.runtime/control-artifacts
CONTROL_PORT=5010
CONTROL_RESERVATION_SECONDS=1800
CONTROL_GRACE_SECONDS=300
CONTROL_MAX_ATTEMPTS=5
CONTROL_MAX_UPLOAD_MB=32
CONTROL_PUBLISH_LEGACY=1
TM_ENV=development
TM_LOAD_LEGACY_ENV=0
TM_DATABASE_URL=postgresql://fleet_dev_admin@127.0.0.1:55439/fleet_dev_control
TM_FLEET_CONTROL_ENABLED=1
TM_AUTO_MIGRATE=0
TM_BACKGROUND_TASKS_ENABLED=0
TM_BIND_HOST=127.0.0.1
COOKIE_SECURE=0
USE_WAITRESS=1
