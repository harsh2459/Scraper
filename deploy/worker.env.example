WORKER_COORDINATOR_URL=http://127.0.0.1:5010
# Pick ONE way to identify this machine:
#  1) Enrollment (recommended): create a key in Administration > Fleet machines > Add a machine, put it here and leave
#     WORKER_TOKEN out. The machine registers itself, appears there as "waiting for approval", and keeps its own
#     credential in its storage folder (worker_identity.json). You name and approve it in the admin panel.
#  2) Manual: register the machine by hand in the admin panel and paste its one-time credential as WORKER_TOKEN.
# WORKER_ENROLL_KEY=tmk_REPLACE_WITH_AN_ENROLLMENT_KEY
WORKER_TOKEN=REPLACE_WITH_THE_CREDENTIAL_FROM_REGISTER_WORKER
WORKER_LOCAL_TOKEN=REPLACE_WITH_A_RANDOM_LOCAL_TOKEN_AT_LEAST_24_CHARACTERS
WORKER_STORAGE_DIR=H:/Datascraper-updates/.runtime/worker
WORKER_PORT=5011
WORKER_BATCH_SIZE=5
WORKER_BATCH_SECONDS=1200
# fixture generates synthetic records; live uses real portal access.
WORKER_MODE=fixture
# offline: reserve, scrape, disconnect, upload (default).
# split: guarded portal routing plus coordinator delivery while connected.
# Live split mode requires a reviewed config with all portal A/AAAA and any
# configured DNS addresses covered. Current exported DNS overrides need review.
WORKER_NETWORK_MODE=offline
WORKER_NETWORK_CHECK_SECONDS=30
# Additional redirect/document hosts require an explicit routing review.
WORKER_PORTAL_HOSTS=tmrsearch.ipindia.gov.in
# Download safety checks, independently of the trademark refresh schedule.
WORKER_FULL_CHECK_DAYS=30
# Optional local OCR; leave empty when Tesseract is not installed.
WORKER_OCR_EXECUTABLE=
WORKER_OCR_LANGUAGE=eng
WORKER_MAX_PENDING=100
WORKER_MIN_FREE_MB=256
# Live: a name from shared-scraper/vpn-configs, without .conf.
WORKER_VPN_CONFIG=
# Optional private config directory; empty uses shared-scraper/vpn-configs.
WORKER_VPN_CONFIG_DIR=
# Optional fallback if no account was assigned from the admin panel.
WORKER_ACCOUNT_FILE=
SCRAPER_LOAD_LEGACY_ENV=0
SCRAPER_EXTERNAL_VPN_CONTROL=1
