# Store the three real environment files privately on Contabo, chmod 600.
# These lines show settings; this file is NOT a production configuration.
# staging-migration.env: migration-owner role, staging DB ONLY
CONTROL_ENV=production
CONTROL_DATABASE_URL=postgresql://STAGING_MIGRATION_OWNER:REPLACE@127.0.0.1:5432/fleet_staging_datascraper
CONTROL_ADMIN_TOKEN=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_24_CHARACTERS
CONTROL_ARTIFACT_DIR=/var/lib/tmtracker/staging/fleet-artifacts
# staging-control.env: use a separate coordinator role with reviewed grants
# Same CONTROL_* settings, but the coordinator's own database login.
CONTROL_PUBLISH_LEGACY=1
# staging-user.env: user API's own database login; copy reviewed app settings
TM_DATABASE_URL=postgresql://STAGING_USER_SERVICE:REPLACE@127.0.0.1:5432/fleet_staging_datascraper
SECRET_KEY=REPLACE_WITH_RANDOM_SESSION_SECRET
COOKIE_SECURE=1
# Correct Drive account configuration will be applied at the deployment stage.
# Never copy private authorization, existing .env or VPN configs into an image.
