# ── BACKEND .env  (copy to  /opt/tmtracker/tm_manager/.env) ────────────────
# Read by tm_manager/config.py.

# ── PostgreSQL (SAME database the scraper uses) ───────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=datascraper
PG_USER=tmtracker
PG_PASSWORD=Nvgalani@369

# ── Where the scraper's API lives (same VPS, localhost only) ─────────────
SCRAPER_API_BASE_URL=http://127.0.0.1:5001

# ── This app's port ────────────────────────────────────────────────────
TM_MANAGER_PORT=5005

# ── DB connection pool ─────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=12

# ── Staleness auto-refresh (re-fetch marks older than N days in the
#    background). Only takes effect when scheduler._AUTO_FETCH_ENABLED is on
#    AND warm-pool accounts exist. ────────────────────────────────────────
REFRESH_INTERVAL_DAYS=7
STALE_REFRESH_BATCH=20

# ── Server ────────────────────────────────────────────────────────────
USE_WAITRESS=1
# HTTP Basic auth — THIS is the gate the public hits (via nginx).
# Use the SAME user/pass as the scraper .env.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=Nvgalani@369

# ── Error tracking (optional) ────────────────────────────────────────────
# Leave blank to disable. Own DSN so backend errors land in a separate
# Sentry project from the scraper/pdf-scraper.
SENTRY_DSN_BACKEND=

# ── Rate limiting (optional) ─────────────────────────────────────────────
# Flask-Limiter storage backend. memory:// is fine for a single Waitress
# process (the current deployment); switch to a redis:// URL only if this
# service ever runs multi-process, where per-process memory limits would
# let a client dodge the limit by landing on a different worker.
RATE_LIMIT_STORAGE_URI=memory://
