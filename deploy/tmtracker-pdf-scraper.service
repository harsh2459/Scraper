[Unit]
Description=TM Tracker - PDF Scraper (saves/parses PDFs handed off by the scraper)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tmtracker
Group=tmtracker
WorkingDirectory=/opt/tmtracker
Environment=USE_WAITRESS=1
ExecStart=/opt/tmtracker/.venv/bin/python /opt/tmtracker/pdf_scraper/app.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/tmtracker/pdf-scraper.log
StandardError=append:/var/log/tmtracker/pdf-scraper.err

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tmtracker /var/log/tmtracker

[Install]
WantedBy=multi-user.target
