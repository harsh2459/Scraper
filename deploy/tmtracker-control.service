[Unit]
Description=TM Tracker fleet control API and scheduler
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tmtracker
Group=tmtracker
WorkingDirectory=/opt/tmtracker
EnvironmentFile=/etc/tmtracker/control.env
ExecStart=/opt/tmtracker/.venv/bin/python -m control_plane
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tmtracker/fleet-artifacts

[Install]
WantedBy=multi-user.target
