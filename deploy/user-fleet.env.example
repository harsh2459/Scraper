# Production example; user and control backends share a database, not a login.
TM_ENV=production
TM_LOAD_LEGACY_ENV=0
TM_DATABASE_URL=postgresql://tm_user_service:REPLACE_PASSWORD@127.0.0.1:5432/REPLACE_DATABASE
TM_FLEET_CONTROL_ENABLED=1
TM_AUTO_MIGRATE=0
TM_BIND_HOST=127.0.0.1
TM_BACKGROUND_TASKS_ENABLED=1
CONTROL_ARTIFACT_DIR=/var/lib/tmtracker/fleet-artifacts
TM_CONTROL_API_BASE=http://127.0.0.1:5010
TM_CONTROL_ADMIN_TOKEN=REPLACE_WITH_THE_CONTROL_SERVICE_ADMIN_TOKEN
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECURE=1
USE_WAITRESS=1
# Copy the required subscription, journal, SMTP and other user-service settings
# explicitly from the reviewed existing config. Legacy .env loading is off.
