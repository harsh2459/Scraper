# ── SCRAPER .env  (copy to  /opt/tmtracker/.env) ───────────────────────────
# Every value here is read by config.py. Fill in the CHANGE_ME lines.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=datascraper
PG_USER=tmtracker
PG_PASSWORD=Nvgalani@369

# ── Email OTP (single fallback mailbox; warm-pool accounts are added via
#    scripts/pool_accounts.py, not here) ────────────────────────────────────
OTP_EMAIL_ADDRESS=fallback@gmail.com
OTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
OTP_IMAP_SERVER=imap.gmail.com
OTP_IMAP_PORT=993
OTP_TIMEOUT_SECONDS=60
OTP_POLL_INTERVAL=3
OTP_SENDER_FILTER=nic.in
OTP_SUBJECT_FILTER=OTP
OTP_USE_IDLE=1

# ── Grok CAPTCHA fallback (optional) ─────────────────────────────────────
GROK_API_KEY=

# ── DB connection pool ─────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=12

# ── Warm session pool ────────────────────────────────────────────────────
WARM_POOL_ENABLED=1
WARM_POOL_MIN_READY=1
WARM_POOL_MAX_SESSION_AGE_SECONDS=1500
# cap simultaneous warm lanes (0 = one per warm account). Lower it if IP
# India starts blocking bursts from this VPS's single IP.
WARM_POOL_MAX_CONCURRENT=0
WARM_POOL_LIVENESS_MAX_AGE_SECONDS=45

# ── Outbound proxy for IP India (optional; residential proxy for a
#    datacenter IP). Leave blank for a direct connection. ──────────────────
SCRAPE_PROXY_URL=

# ── Server ──────────────────────────────────────────────────────────────
USE_WAITRESS=1
# HTTP Basic auth on the scraper (defence in depth — nginx doesn't expose
# :5001 publicly, but set it anyway). Same creds as the backend below.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=Nvgalani@369

# ── Error tracking (optional) ────────────────────────────────────────────
# Leave blank to disable. Own DSN per service so errors land in separate
# Sentry projects (scraper vs backend vs pdf-scraper) instead of one stream.
SENTRY_DSN_SCRAPER=
