[Unit]
Description=TM Tracker - Backend (TM Manager API)
After=network-online.target postgresql.service tmtracker-scraper.service
Wants=network-online.target

[Service]
Type=simple
User=tmtracker
Group=tmtracker
WorkingDirectory=/opt/tmtracker/tm_manager
Environment=USE_WAITRESS=1
ExecStart=/opt/tmtracker/.venv/bin/python /opt/tmtracker/tm_manager/app.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/tmtracker/backend.log
StandardError=append:/var/log/tmtracker/backend.err

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tmtracker /var/log/tmtracker

[Install]
WantedBy=multi-user.target
