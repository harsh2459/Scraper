# Deny by default: never send private runtime, data, VPN configs or old deploy notes.
**
!shared-scraper/
!shared-scraper/*.py
!shared-scraper/requirements.txt
!shared-scraper/control_plane/
!shared-scraper/control_plane/*.py
!shared-scraper/control_plane/requirements.txt
!shared-scraper/migrations/
!shared-scraper/migrations/*.py
!shared-scraper/migrations/*.sql
!shared-scraper/tm_manager/
!shared-scraper/tm_manager/*.py
!shared-scraper/tm_manager/requirements.txt
!shared-scraper/tm_manager/templates/
!shared-scraper/tm_manager/templates/**
!shared-scraper/tm_manager/scripts/
!shared-scraper/tm_manager/scripts/parse_journal.py
!shared-scraper/tm_manager/scripts/auto_fetch_journal.py
!shared-scraper/tm_manager/frontend/
!shared-scraper/tm_manager/frontend/**
!shared-scraper/ops_frontend/
!shared-scraper/ops_frontend/**
!deploy/
!deploy/containers/
!deploy/containers/**
**/node_modules/**
**/dist/**
**/__pycache__/**
**/.env*
**/.secret*
**/*.log
**/*.err
**/*.md
**/*.db
**/*.dump
**/*.zip
**/*.pdf
**/*.conf
!deploy/containers/staging-nginx.conf
**/*.pem
**/*.key
**/*.pyc
