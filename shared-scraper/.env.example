# Datascraper — Email OTP Configuration
# Copy to .env and fill in your own values.

OTP_EMAIL_ADDRESS=
OTP_IMAP_SERVER=
OTP_IMAP_PORT=
OTP_TIMEOUT_SECONDS=
OTP_APP_PASSWORD=
OTP_SENDER_FILTER=
OTP_SUBJECT_FILTER=
GROK_API_KEY=
PG_HOST=
PG_PORT=
PG_DBNAME=
PG_USER=
PG_PASSWORD=
# Client-cert auth (see db.py's _get_pool) — Contabo's pg_hba.conf trusts
# this cert from ANY IP (checked before the old per-IP rules), so VPN
# on/off or an ISP change on this machine never needs a firewall/pg_hba
# edit again. PG_PASSWORD above is now just a fallback if these files are
# ever missing.
PG_SSLCERT=
PG_SSLKEY=

# PDF documents are handed off to CONTABO's pdf_scraper (not this
# machine's local one) so Contabo — which never has a VPN and always has
# a working DB + Google Drive connection — does the actual save/parse/
# Drive-upload. This machine's own Postgres access can still be flaky
# while its VPN is on (needed for IP India), but that no longer risks
# losing a downloaded document: the PDF goes straight to Contabo over a
# normal HTTPS call the moment it's downloaded, regardless of whether
# this machine's own DB write for the search result succeeds or not.
# Exposed via nginx at scraper.mytmtracker.com/pdf-scraper-api/ (see
# _send_to_pdf_scraper in app.py) — the actual pdf_scraper process stays
# 127.0.0.1:5002-only on Contabo, this route just proxies to it.
PDF_SCRAPER_BASE_URL=
# Contabo's own BASIC_AUTH_USER/PASS (/opt/tmtracker/.env) — required by
# pdf_scraper's own auth check. Deliberately NOT named BASIC_AUTH_USER/
# PASS here — see config.py's PDF_SCRAPER_AUTH_USER comment for why reusing
# that name would be wrong now that this calls a different machine.
PDF_SCRAPER_AUTH_USER=
PDF_SCRAPER_AUTH_PASS=

# Fleet worker mode — this machine scrapes on behalf of Contabo (its IP is
# blocked by IP India), reporting results back to Contabo's Postgres above.
FLEET_MODE_ENABLED=
FLEET_MACHINE_KEY=
FLEET_COORDINATOR_URL=

# Must match tm_manager/.env's OPS_API_USER/OPS_API_PASS on this same
# machine — lets _run_batch_job call tm_manager's /api/fleet/claim-more
# to refill a batch mid-session (same login, back-to-back like Auto
# Discover) instead of stopping at a fixed AUTO_FETCH_BATCH_SIZE. Kept
# separate from BASIC_AUTH_USER/PASS on purpose — that pair turns on a
# global auth gate on THIS scraper's own incoming API (see app.py's
# before_request block), which would break tm_manager's existing
# unauthenticated calls into /api/scrape-appno-batch.
TM_MANAGER_OPS_USER=
TM_MANAGER_OPS_PASS=

# Warm pool is Contabo's own responsibility (its priority accounts for fast
# Live Refresh) — WARM_POOL_ENABLED defaults to 1, which meant this machine
# was ALSO trying to keep bmapublicationpvtltd@gmail.com (a warm-pool
# account, not assigned to this machine) logged in at the same time Contabo
# was — the two processes fighting over one session caused an 18-attempt
# "already logged in on another tab" retry loop that never succeeded. This
# worker only needs the cold pool (fleet-assigned accounts).
WARM_POOL_ENABLED=

# Google Drive document storage (see scripts/google_drive_auth_setup.py)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
