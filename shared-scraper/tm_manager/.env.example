# TM Manager — Configuration
# Copy to .env and fill in your own values.

PG_HOST=
PG_PORT=
PG_DBNAME=
PG_USER=
PG_PASSWORD=
# Client-cert auth — see the root .env's PG_SSLCERT/PG_SSLKEY comment
# (path is relative to this process's own working directory, tm_manager/,
# so it points up one level to the shared certs/ folder).
PG_SSLCERT=
PG_SSLKEY=

SCRAPER_API_BASE_URL=
TM_MANAGER_PORT=

# Fleet worker mode — same machine identity as the root .env (both are read
# by this machine's own scheduler.py, which is what actually polls Contabo
# for assignments — see config.py's comment on why both files need this).
FLEET_MODE_ENABLED=
FLEET_MACHINE_KEY=
FLEET_COORDINATOR_URL=

# Must match the root .env's TM_MANAGER_OPS_USER/TM_MANAGER_OPS_PASS on this
# same machine — accepted by _check_ops_credentials (see app.py) so the
# scraper's _run_batch_job can call /api/fleet/claim-more to refill a batch
# mid-session instead of logging out every fixed AUTO_FETCH_BATCH_SIZE marks.
OPS_API_USER=
OPS_API_PASS=

# Step 2 of gradual scale-up (see WARM_POOL_ENABLED note in root .env for
# what caused the original 401 rate-limit). 1 worker confirmed clean at
# 07:45+ with 0 errors. Moving to 3 (half of the 6 assigned accounts) —
# NOT jumping straight to 6, since that's the exact kind of burst that
# caused the original block. Watch for 401s before going higher.
AUTO_FETCH_WORKERS=
# Raised from 5: with WARM_POOL_ENABLED=0 on this machine, every batch pays
# one full cold login (~60-90s CAPTCHA+OTP) plus a 120s post-batch account
# cooldown regardless of batch size — at 5 items/batch that fixed overhead
# dominated total time, so each account only cleared ~5 marks per ~3-5 min
# cycle. This doesn't change login frequency or worker count (the axis that
# caused the 401 above), just how many marks one already-paid-for login
# covers — up to the server's own _BATCH_MAX_APP_NOS=50 cap (app.py).
AUTO_FETCH_BATCH_SIZE=

DIGEST_EMAIL_ADDRESS=
DIGEST_EMAIL_APP_PASSWORD=
COOKIE_SECURE=

# Google Drive document storage (see scripts/google_drive_auth_setup.py) —
# same values as the root .env, duplicated here since tm_manager reads its
# own separate .env with no shared-secrets mechanism between the two.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
