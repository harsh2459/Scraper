# Datascraper — Email OTP Configuration
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and never shared.

# ── Required ─────────────────────────────────────────────────────────────────
OTP_EMAIL_ADDRESS=you@gmail.com
OTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── IMAP server (defaults shown below) ───────────────────────────────────────
# Gmail:           imap.gmail.com          port 993
# Outlook/Hotmail: outlook.office365.com   port 993
# Yahoo:           imap.mail.yahoo.com     port 993
OTP_IMAP_SERVER=imap.gmail.com
OTP_IMAP_PORT=993

# ── Timing ───────────────────────────────────────────────────────────────────
OTP_TIMEOUT_SECONDS=60    # how long to wait for OTP email
OTP_POLL_INTERVAL=3       # seconds between inbox checks

# ── Optional filters (leave blank to accept any OTP email) ───────────────────
OTP_SENDER_FILTER=        # e.g. quickcompany.in
OTP_SUBJECT_FILTER=       # e.g. OTP

# ── Grok API (optional) ───────────────────────────────────────────────────────
# Used only as a fallback CAPTCHA solver if the built-in math parser can't
# understand the IP India CAPTCHA question (e.g. portal changes the wording).
# Get a key from https://console.x.ai
GROK_API_KEY=

# ── PostgreSQL (local database) ───────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=datascraper
PG_USER=postgres
PG_PASSWORD=

# ── Error tracking (optional) ──────────────────────────────────────────────────
# Sentry DSN for THIS service (the root scraper app). Leave blank to disable —
# every service is a no-op without its own DSN. tm_manager/pdf_scraper each
# have their own DSN var (see their own .env.example) so errors land in
# separate Sentry projects instead of one undifferentiated stream.
SENTRY_DSN_SCRAPER=
